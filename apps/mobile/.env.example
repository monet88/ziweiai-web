# ==============================================================================
# ViOS — Tử Vi Toàn Tập Mobile Environment Configuration
# ==============================================================================

# Backend API & Database
SUPABASE_URL=https://uaicvwttnajeglxiorpb.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
API_URL=https://tuvitoantap.vercel.app/api

# ------------------------------------------------------------------------------
# In-App Purchases (RevenueCat)
# ------------------------------------------------------------------------------
# Development: Use test keys starting with 'test_'
# Production Release:
#   - Apple App Store: starts with 'appl_' (from RevenueCat Project Settings > API Keys)
#   - Google Play Store: starts with 'goog_' (from RevenueCat Project Settings > API Keys)
REVENUECAT_API_KEY_APP_STORE=your_apple_store_key_here
REVENUECAT_API_KEY_PLAY_STORE=your_google_play_key_here
# Backwards compatibility aliases:
REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=

# ------------------------------------------------------------------------------
# Google AdMob (Rewarded Video Unit IDs)
# ------------------------------------------------------------------------------
# Leave empty to automatically fallback to Google's official Test Ad IDs:
#   Android Test ID: ca-app-pub-3940256099942544/5224354917
#   iOS Test ID:     ca-app-pub-3940256099942544/1712485313
# Production Release:
#   - Set your real AdMob Rewarded Ad Unit ID generated from Google AdMob Console
ADMOB_REWARDED_ID_ANDROID=
ADMOB_REWARDED_ID_IOS=
