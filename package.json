{
  "name": "ziweiai-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "vercel-build": "pnpm rebuild esbuild && pnpm --filter @ziweiai/contracts build && pnpm --filter @ziweiai/core build && pnpm --filter @ziweiai/xuanshu-runtime build && pnpm --filter @ziweiai/astro-engine build && pnpm --filter @ziweiai/api build && pnpm --filter @ziweiai/web build",
    "build": "turbo run build",
    "check:supabase-migrations": "scripts/check-supabase-migrations.zsh",
    "deploy:vercel-demo": "scripts/deploy-vercel-demo.zsh",
    "dev": "turbo run dev --parallel",
    "lint": "eslint . --max-warnings=0",
    "smoke:vercel-demo": "scripts/smoke-vercel-demo.zsh",
    "smoke:vercel-live-mutation": "scripts/smoke-vercel-live-mutation.zsh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.19.0",
    "prettier": "^3.6.2",
    "svelte-eslint-parser": "^1.8.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}
